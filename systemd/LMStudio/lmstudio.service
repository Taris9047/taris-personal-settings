[Unit]
Description=LM Studio Server
After=network.target

[Service]
Type=oneshot
User=taris
RemainAfterExit=yes
Environment="HOME=/home/taris"
EnvironmentFile=/home/taris/.lms_model.env
ExecStartPre=/home/taris/.lmstudio/bin/lms daemon up
ExecStartPre=/home/taris/.lmstudio/bin/lms unload --all
ExecStartPre=/home/taris/.lmstudio/bin/lms load ${LM_MODEL} --context-length ${LM_CONTEXT} --yes 
ExecStart=/home/taris/.lmstudio/bin/lms server start
ExecStop=/home/taris/.lmstudio/bin/lms daemon down

[Install]
WantedBy=default.target
