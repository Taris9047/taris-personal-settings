[Unit]
Description=LM Studio Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h

# Environment variables
EnvironmentFile=%h/.lms_model.env
ExecStartPre=%h/.lmstudio/bin/lms daemon up

# Actually start the server
ExecStart=/bin/bash -c "$HOME/.lmstudio/bin/lms server start && tail -f /dev/null"

# Stop procedures
ExecStop=%h/.lmstudio/bin/lms server stop
ExecStopPost=%h/.lmstudio/bin/lms daemon down

# Restart Conditions
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
